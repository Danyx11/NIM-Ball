{
  "name": "nim-ball",
  "main": "party/index.js",
  "compatibility_date": "2026-08-13",
  "durable_objects": {
    "bindings": [
      { "name": "Arbiter", "class_name": "Arbiter" },
      // WEEK's two classes (see party/weekArbiter.js / party/playerIndex.js)
      // — added alongside Arbiter, not folded into it, so this config change
      // can't affect the existing LIVE binding above.
      { "name": "WeekArbiter", "class_name": "WeekArbiter" },
      { "name": "PlayerIndex", "class_name": "PlayerIndex" },
      // NIM-Curl Radar's single counter/report store (party/radar.js) — a
      // fourth class added the same way WEEK's two were: alongside the
      // existing bindings above, never folded into them, so this change
      // can't affect LIVE or WEEK.
      { "name": "RadarCollector", "class_name": "RadarCollector" },
      // League Beta's season store (party/leagueSeason.js) — a fifth class,
      // added the same way, for the same reason: alongside every binding
      // above, never folded into them, so this can't affect LIVE, WEEK or
      // Radar.
      { "name": "LeagueSeason", "class_name": "LeagueSeason" },
      // WEEK turn-notification linking (party/telegramLink.js) — a sixth
      // class, same reasoning again: alongside every binding above, never
      // folded into them.
      { "name": "TelegramLink", "class_name": "TelegramLink" },
      // Partnership sponsor-week booking (party/partnership.js) — a seventh
      // class, same reasoning again: alongside every binding above, never
      // folded into them.
      { "name": "Partnership", "class_name": "Partnership" },
    ],
  },
  // new_sqlite_classes (not new_classes) — required for Durable Objects on
  // Cloudflare's free Workers plan, see git history: the old `partykit` CLI
  // only knew how to generate the classic (paid-plan-only) migration type,
  // which is what made this rewrite necessary in the first place.
  //
  // v1 (Arbiter) is untouched, on purpose — a migrations entry is a one-time
  // deploy record, not something to edit after the fact. v2 adds the two
  // WEEK classes as their own migration step; v3 does the same for Radar.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Arbiter"] },
    { "tag": "v2", "new_sqlite_classes": ["WeekArbiter", "PlayerIndex"] },
    { "tag": "v3", "new_sqlite_classes": ["RadarCollector"] },
    { "tag": "v4", "new_sqlite_classes": ["LeagueSeason"] },
    { "tag": "v5", "new_sqlite_classes": ["TelegramLink"] },
    { "tag": "v6", "new_sqlite_classes": ["Partnership"] },
  ],
  // Drives RadarCollector#maybeSendDailyReport (party/radar.js) — a coarse
  // 15-minute tick is enough since that method itself re-checks the current
  // Europe/Paris wall-clock date on every call and only ever sends once per
  // day (see its own comment for the DST/downtime reasoning).
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  // Plain (non-secret) Worker env vars — party/partnership.js's confirmPayment
  // reads these via this.env. Neither value is sensitive (a public RPC
  // endpoint, a public wallet address), so `vars` here rather than
  // `wrangler secret put` — same reasoning src/partnership.js's own
  // VITE_PARTNERSHIP_PAYMENT_ADDRESS comment gives for the frontend's copy
  // of this same address. PARTNERSHIP_PAYMENT_ADDRESS below is currently the
  // address used for the supervised real-wallet test (see conversation), NOT
  // the production recipient — replace before this goes live, same caveat
  // as the frontend's .env.example.
  "vars": {
    "NIMIQ_RPC_URL": "https://rpc.nimiqwatch.com",
    "PARTNERSHIP_PAYMENT_ADDRESS": "NQ55 YBJ1 QDMF KHT2 25PJ KVAT YTVD 2JHE RHX7",
  },
  // Sponsor banner storage (party/partnership.js's uploadBanner/getBanner) —
  // the bucket itself must exist in Cloudflare before this binding resolves
  // (`wrangler r2 bucket create nim-ball-partnership-banners`, a real cloud
  // resource, not created automatically by this config); `wrangler dev`
  // emulates it locally with no such step needed.
  "r2_buckets": [
    { "binding": "PARTNERSHIP_BANNERS", "bucket_name": "nim-ball-partnership-banners" },
  ],
}
