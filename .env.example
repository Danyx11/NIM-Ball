# Vite build-time env vars (import.meta.env.VITE_*, inlined into the bundle
# at build time — not secrets, just build config; see vite.config.js for how
# this project already branches on the deploy target).
#
# NIM address that receives Partnership payments (src/partnership.js) AND
# alias-claim payments (src/main.js's claim dialog, party/aliases.js) — one
# project treasury address for every paid feature, not a var per feature.
# Not a secret (it's a public wallet address), but never hardcoded in source —
# set it here for local dev, and in the deploy platform's build env (Vercel /
# GitHub Pages Actions) for production, since Vite inlines VITE_* vars at
# build time, not at runtime.
VITE_PARTNERSHIP_PAYMENT_ADDRESS=
